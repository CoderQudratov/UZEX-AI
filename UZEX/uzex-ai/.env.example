# Local use only: copy to .env. Never commit real credentials.
APP_ENV=development
GEMINI_API_KEY=
# Set an available Gemini Flash-family model ID before production.
GEMINI_MODEL=gemini-3.8-flash
DATABASE_PATH=data/processed/uzex.duckdb
MAX_CONCURRENT_QUERIES=4
GEMINI_TIMEOUT_SECONDS=20
PORT=8000

# Explicit semantic provider; never automatically switches.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
